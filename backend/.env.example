# Optional. If empty, the backend uses fallback review logic.
OPENAI_API_KEY=

# Optional model name.
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible base URL for other providers.
OPENAI_BASE_URL=

# Comma-separated CORS origins. Add your deployed frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
