# Optional. If empty, the backend uses fallback review logic.
OPENAI_API_KEY=

# Optional model name.
OPENAI_MODEL=gpt-4o-mini

# Optional OpenAI-compatible base URL for other providers.
OPENAI_BASE_URL=

# Free local AI option with Ollama:
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5-coder:0.5b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_TIMEOUT_SECONDS=90
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_PREDICT=900

# Comma-separated CORS origins. Add your deployed frontend URL here.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
